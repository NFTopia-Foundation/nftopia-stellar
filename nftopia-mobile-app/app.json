{
  "expo": {
    "name": "NFTopia",
    "slug": "nftopia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nftopia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nftopia.app",
      "associatedDomains": [
        "applinks:nftopia.io",
        "applinks:www.nftopia.io"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nftopia.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "nftopia.io",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.nftopia.io",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "nftopia"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C5CE7",
          "sounds": ["./assets/notification-sound.wav"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NFTopia uses your camera to scan WalletConnect pairing codes and wallet addresses.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "environment": "$EXPO_PUBLIC_APP_ENVIRONMENT",
      "apiBaseUrl": "$EXPO_PUBLIC_API_BASE_URL",
      "posthogApiKey": "$EXPO_PUBLIC_POSTHOG_API_KEY",
      "posthogHost": "$EXPO_PUBLIC_POSTHOG_HOST",
      "sentryDsn": "$EXPO_PUBLIC_SENTRY_DSN",
      "stellarNetwork": "$EXPO_PUBLIC_STELLAR_NETWORK",
      "stellarHorizonUrl": "$EXPO_PUBLIC_STELLAR_HORIZON_URL",
      "deepLinkScheme": "$EXPO_PUBLIC_DEEP_LINK_SCHEME",
      "deepLinkHost": "$EXPO_PUBLIC_DEEP_LINK_HOST",
      "encryptionKey": "$EXPO_PUBLIC_ENCRYPTION_KEY",
      "enableAnalytics": "$EXPO_PUBLIC_ENABLE_ANALYTICS",
      "enablePerformanceMonitoring": "$EXPO_PUBLIC_ENABLE_PERFORMANCE_MONITORING",
      "enableErrorTracking": "$EXPO_PUBLIC_ENABLE_ERROR_TRACKING",
      "enableBiometric": "$EXPO_PUBLIC_ENABLE_BIOMETRIC",
      "wsUrl": "$EXPO_PUBLIC_WS_URL"
    }
  }
}