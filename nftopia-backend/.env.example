# Server Configuration
PORT=3000
GRAPHQL_PORT=3001
NODE_ENV=development
GRAPHQL_PLAYGROUND_ENABLED=true
GRAPHQL_INTROSPECTION_ENABLED=true
LOG_LEVEL=info
LOG_SAMPLE_RATE=1.0

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# CORS Configuration
# Development: comma-separated list of additional origins to allow
# Production: comma-separated list of allowed origins (REQUIRED)
CORS_ALLOWED_ORIGINS=https://nftopia.com,https://app.nftopia.com
CORS_ORIGIN_DEV=http://localhost:3001

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# Database Configuration (Optional for future use)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nftopia

# MongoDB Configuration (analytics/event data — #531)
# Flexible, schema-light document storage for analytics/event data, kept
# separate from the relational Postgres schema above. See
# docs/mongodb-analytics.md for the schema and retention policy.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nftopia_analytics
# Connection retry/backoff — NestJS retries the initial connection this
# many times, waiting this long between attempts, before giving up.
MONGO_RETRY_ATTEMPTS=10
MONGO_RETRY_DELAY_MS=3000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# JWT Configuration
# JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Stellar/Soroban Configuration
#
# SOROBAN_RPC_URL — the JSON-RPC endpoint used for all Soroban contract calls.
# It is validated and normalized at startup:
#   - Must be a valid http(s) URL (malformed URLs are rejected early).
#   - In production it is REQUIRED and must be https (localhost is rejected).
#   - Trailing slashes are removed automatically.
# The endpoint is health-checked on boot; the URL in use is logged at startup.
#
# Testnet (default for local development):
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Mainnet (set STELLAR_NETWORK=mainnet as well):
#   SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
#
# STELLAR_NETWORK — testnet | mainnet (case-insensitive). Defaults to testnet.
STELLAR_NETWORK=TESTNET
COLLECTION_FACTORY_CONTRACT_ID=CB6UOYI5KLAXLBBALZITFMCR6LIDHW2BQFRB7VXMUWZ6Z2BFTG3UFPM4
TRANSACTION_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TRANSACTION_TIMEOUT_SECONDS=60
SOROBAN_RPC_MAX_RETRIES=3
SOROBAN_RPC_RETRY_DELAY_MS=1000
SOROBAN_RPC_RETRY_BACKOFF_MULTIPLIER=2
SOROBAN_RPC_RETRY_MAX_DELAY_MS=30000
# Optional server-side signer for state-changing Soroban transactions.
# STELLAR_OPERATOR_PUBLIC_KEY=G...
# STELLAR_OPERATOR_SECRET=S...
# SOROBAN_EVENT_CONTRACT_IDS=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Decentralized Storage Configuration
IPFS_PROVIDER=pinata
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
IPFS_MAX_FILE_SIZE_BYTES=52428800
IPFS_RETRY_ATTEMPTS=2
IPFS_RETRY_BACKOFF_MS=250
IPFS_PINATA_JWT=
IPFS_WEB3STORAGE_TOKEN=
IPFS_NFTSTORAGE_TOKEN=

ARWEAVE_GATEWAY_URL=https://arweave.net
ARWEAVE_MAX_FILE_SIZE_BYTES=104857600
ARWEAVE_HOST=arweave.net
ARWEAVE_PORT=443
ARWEAVE_PROTOCOL=https
ARWEAVE_RETRY_ATTEMPTS=2
ARWEAVE_RETRY_BACKOFF_MS=350
ARWEAVE_WALLET_PATH=
ARWEAVE_WALLET_JWK=

STORAGE_FALLBACK_ENABLED=true

# Malware Scanning (ClamAV via clamd TCP)
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCAN_TIMEOUT_MS=60000
SCAN_RETRY_ATTEMPTS=3
SCAN_RETRY_BACKOFF_MS=500
# Files larger than this are queued for async scanning instead of blocking the upload request.
SCAN_ASYNC_THRESHOLD_BYTES=20971520
# If true, a scan error blocks the upload instead of allowing it through unscanned.
SCAN_FAIL_CLOSED=true
STORAGE_MALWARE_WEBHOOK_URL=
SCAN_RESCAN_BATCH_SIZE=25
SCAN_RESCAN_STALE_AFTER_MS=604800000

# Meilisearch Configuration
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-search-key

# AI Agent (marketplace assistant)
ANTHROPIC_API_KEY=
# Per-user rate limit for POST /ai/chat (keyed by authenticated user id, not IP).
# Independent of the global RATE_LIMIT/RATE_LIMIT_TTL used by RedisRateGuard,
# since each chat request can trigger multiple billed Anthropic API calls.
AI_CHAT_RATE_LIMIT_POINTS=20
AI_CHAT_RATE_LIMIT_TTL=600
# Per-user token spend caps for POST /ai/chat and /ai/chat/stream, checked
# before every Anthropic API call (see AiUsageService.assertWithinCap).
# Counts input+output tokens across all models for the calling user over
# the current UTC calendar day / month (see GET /ai/usage). An admin can
# override these per-user via POST/DELETE /ai/admin/usage/:userId/override
# (see docs/ai-chat-spend-caps.md).
AI_CHAT_DAILY_TOKEN_CAP=200000
AI_CHAT_MONTHLY_TOKEN_CAP=2000000
# Optional USD spend caps, checked alongside the token caps above using the
# already-tracked estimated cost per call. Leave unset to enforce token
# caps only (estimated cost is still tracked and returned by GET /ai/usage
# either way).
AI_CHAT_DAILY_SPEND_CAP_USD=
AI_CHAT_MONTHLY_SPEND_CAP_USD=
# Fraction (0-1) of a cap at which GET /ai/usage's approachingCap flag
# turns on, so a client can warn the user before they're actually blocked.
AI_CHAT_CAP_WARNING_THRESHOLD=0.8

# Per-user rate limit for POST /ai/copilot/draft-listing (#528), keyed by
# authenticated user id like AI_CHAT_RATE_LIMIT_* above, but tracked in its
# own Redis bucket via CopilotRateLimitGuard so drafting listings can't
# starve, or be starved by, /ai/chat usage.
AI_COPILOT_RATE_LIMIT_POINTS=5
AI_COPILOT_RATE_LIMIT_TTL=3600

# Marketplace Settlement Smart Contract
MARKETPLACE_SETTLEMENT_CONTRACT_ID=CB7QBOUQ3YRBOTGZ32RNKQIBGIBL4EQRIQUYV4KEMIDVJ5IRQV57IXSK
CONTRACT_TRANSACTION_TIMEOUT=60
ENABLE_ONCHAIN_SETTLEMENT=true

# Transaction Retry Configuration
TRANSACTION_RETRY_MAX_ATTEMPTS=6
TRANSACTION_RETRY_BASE_DELAY_MS=1000
TRANSACTION_RETRY_MAX_DELAY_MS=300000
TRANSACTION_RETRY_BACKOFF_MULTIPLIER=2
TRANSACTION_RETRY_USE_JITTER=true

# Two-Factor Authentication (2FA) Configuration
TOTP_CODE_LENGTH=6
TOTP_WINDOW=1
TOTP_TIME_STEP=30
TOTP_ISSUER=NFTopia
TOTP_ALGORITHM=sha1
TOTP_ENCODING=base32
BACKUP_CODE_COUNT=10
BACKUP_CODE_LENGTH=16
TWO_FACTOR_TEMP_TOKEN_EXPIRY_SECONDS=300

# Transactional Email
#
# EMAIL_PROVIDER selects which backend EmailService uses: smtp | sendgrid | resend.
# Only the configuration block for the selected provider needs to be filled in.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@nftopia.com
EMAIL_FROM_NAME=NFTopia
# Base URL used to build links inside emails (verify-email, reset-password, auctions/:id).
FRONTEND_URL=http://localhost:3001

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM=

# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM=

# How long email verification / password reset tokens remain valid.
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Rate limit for endpoints that trigger an outbound email (register, password-reset/request).
EMAIL_RATE_LIMIT_MAX=5
EMAIL_RATE_LIMIT_WINDOW_S=3600

# OpenTelemetry Tracing (see docs/tracing.md)
#
# Defaults to enabled outside NODE_ENV=test; set to false/true to override
# that default in any environment.
OTEL_ENABLED=
# Shows up as the service name in the trace backend (Jaeger, etc).
OTEL_SERVICE_NAME=nftopia-backend
# OTLP/HTTP traces endpoint. The docker-compose `jaeger` service accepts
# OTLP directly, no separate collector needed for local development.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Fraction of root traces to sample, in [0, 1]. Defaults to 1 (trace
# everything) outside production and 0.2 in production if left unset.
OTEL_TRACES_SAMPLE_RATIO=

# Payment module (see docs/payment-module.md)
#
# Used only to verify Stripe webhook signatures and construct the SDK
# client for that — this module does not create/charge PaymentIntents
# itself. Both are required for POST /payments/webhooks/stripe to process
# events; without them it responds 503 rather than skip verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=