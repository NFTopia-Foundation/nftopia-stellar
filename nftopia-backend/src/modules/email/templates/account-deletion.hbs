<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirm account deletion</title>
  </head>
  <body style="margin:0;padding:0;background-color:#0f1117;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#0f1117;padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#171923;border-radius:12px;overflow:hidden;">
            <tr>
              <td style="background:linear-gradient(90deg,#e53e3e,#7f5af0);padding:24px 32px;">
                <span style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:0.5px;">NFTopia</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="color:#ffffff;font-size:22px;margin:0 0 16px;">Confirm account deletion</h1>
                <p style="color:#a0aec0;font-size:15px;line-height:1.6;margin:0 0 24px;">
                  Hi {{username}}, we received a request to permanently delete your NFTopia account and
                  anonymize your personal data. This action cannot be undone once the grace period ends.
                </p>
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="border-radius:8px;background-color:#e53e3e;">
                      <a href="{{{confirmationUrl}}}" style="display:inline-block;padding:14px 28px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;border-radius:8px;">
                        Confirm Deletion
                      </a>
                    </td>
                  </tr>
                </table>
                <p style="color:#718096;font-size:13px;line-height:1.6;margin:24px 0 0;">
                  Or copy and paste this link into your browser:<br />
                  <a href="{{{confirmationUrl}}}" style="color:#7f5af0;word-break:break-all;">{{{confirmationUrl}}}</a>
                </p>
                <p style="color:#718096;font-size:13px;line-height:1.6;margin:24px 0 0;">
                  This link expires in 24 hours. After confirmation you have a 30-day grace period to cancel.
                  If you did not request this, you can safely ignore this email.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px;border-top:1px solid #2d3748;">
                <p style="color:#4a5568;font-size:12px;margin:0;">© NFTopia. Built on Stellar.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
