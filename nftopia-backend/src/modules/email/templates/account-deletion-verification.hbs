<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify account deletion</title>
  </head>
  <body style="margin:0;padding:0;background-color:#101815;font-family:Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 0;">
      <tr><td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background:#17221d;border-radius:8px;">
          <tr><td style="padding:28px 32px;background:#24765b;color:#fff;font-size:20px;font-weight:700;">NFTopia</td></tr>
          <tr><td style="padding:32px;color:#eef5f0;">
            <h1 style="font-size:22px;margin:0 0 16px;">Verify account deletion</h1>
            <p style="font-size:15px;line-height:1.6;color:#c7d5cb;">Hi {{username}}, confirm that you requested deletion of your NFTopia account. Your account will remain recoverable for 30 days after confirmation.</p>
            <p><a href="{{{verificationUrl}}}" style="color:#9ce2bd;">Review your account settings</a></p>
            <p style="font-size:13px;line-height:1.6;color:#aab9ae;">This verification expires in 15 minutes. If you did not request account deletion, ignore this message and keep your account secure.</p>
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>