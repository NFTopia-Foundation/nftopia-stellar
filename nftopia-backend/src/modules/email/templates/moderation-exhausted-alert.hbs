<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI moderation retries exhausted</title>
  </head>
  <body style="margin:0;padding:0;background-color:#0f1117;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#0f1117;padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#171923;border-radius:12px;overflow:hidden;">
            <tr>
              <td style="background:linear-gradient(90deg,#7f5af0,#2cb67d);padding:24px 32px;">
                <span style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:0.5px;">NFTopia</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="color:#ffffff;font-size:22px;margin:0 0 16px;">AI moderation retries exhausted</h1>
                <p style="color:#a0aec0;font-size:15px;line-height:1.6;margin:0 0 16px;">
                  A moderation job used all of its attempts without completing. The listing below may be live without having been moderated and has been added to the admin review queue.
                </p>
                <p style="color:#a0aec0;font-size:14px;line-height:1.6;margin:0 0 8px;">Listing ID: <strong style="color:#ffffff;">{{listingId}}</strong></p>
                <p style="color:#a0aec0;font-size:14px;line-height:1.6;margin:0 0 8px;">Last error: {{errorMessage}}</p>
                <p style="color:#a0aec0;font-size:14px;line-height:1.6;margin:0;">Additional failures suppressed since the last alert: {{suppressedCount}}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px;border-top:1px solid #2d3748;">
                <p style="color:#4a5568;font-size:12px;margin:0;">© NFTopia. Built on Stellar.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
