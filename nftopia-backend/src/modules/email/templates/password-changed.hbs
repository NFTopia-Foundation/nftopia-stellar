<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your password was changed</title>
  </head>
  <body style="margin:0;padding:0;background-color:#0f1117;font-family:Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#0f1117;padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#171923;border-radius:8px;overflow:hidden;">
            <tr>
              <td style="background-color:#2cb67d;padding:24px 32px;">
                <span style="color:#ffffff;font-size:20px;font-weight:700;">NFTopia</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="color:#ffffff;font-size:22px;margin:0 0 16px;">Your password was changed</h1>
                <p style="color:#a0aec0;font-size:15px;line-height:1.6;margin:0;">
                  Hi {{username}}, the password for your NFTopia account was changed successfully.
                  If you did not make this change, contact NFTopia support immediately.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>